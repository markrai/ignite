{
  "schema": "ignite-kindle-preflight-v1",
  "command": "preflight",
  "firmware": "Kindle 5.18.6",
  "installed_version": "0.0.0",
  "handler": "com.markrai.ignite",
  "roots": {
    "library": "/mnt/us/scribe-data",
    "sync": "/mnt/us/scribe-app/state/sync",
    "device": "/mnt/us/scribe-app/state/device"
